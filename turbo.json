{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".nvmrc"
  ],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^generate"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false
    },
    "preview": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
