# Not secret: OpenNext bundles .env* files into the Worker, so secrets go in .dev.vars instead.
# Local Postgres that wrangler uses in place of the Hyperdrive binding during development.
# It must include a password (any value; Postgres.app ignores it), or wrangler silently drops every binding.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://YOUR_MAC_USER:local@localhost:5432/luxe_hair"
