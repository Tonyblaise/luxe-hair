{
  "name": "@luxe-hair/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && set -a && { [ ! -f .env ] || . ./.env; } && set +a && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && set -a && { [ ! -f .env ] || . ./.env; } && set +a && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@luxe-hair/shared": "*",
    "@opennextjs/cloudflare": "^1.20.13",
    "hono": "^4.13.13",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "@luxe-hair/api": "*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
